# LiveKit server URL
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API credentials 
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Sarvam AI API key
SARVAM_API_KEY=your_sarvam_api_key

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key

# LLM model identifier (default: gpt-4.1-mini)
LLM_MODEL=gpt-4.1-mini

# STT model identifier (default: saaras:v3)
STT_MODEL=saaras:v3

# TTS model identifier (default: bulbul:v3)
TTS_MODEL=bulbul:v3

# TTS speaker voice name
TTS_SPEAKER=ritu

# TTS output language (default: en-IN)
TTS_LANGUAGE=en-IN

# Livekit Agent name
AGENT_NAME=ayush-persona

# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
